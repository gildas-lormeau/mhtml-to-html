{
  "name": "mhtml-to-html",
  "version": "2.1.0",
  "author": "Gildas Lormeau",
  "license": "MIT",
  "description": "JavaScript library for parsing MHTML files and converting them into single HTML files",
  "keywords": [
    "mhtml",
    "html",
    "single-file",
    "cli",
    "parsing",
    "conversion"
  ],
  "type": "module",
  "bin": {
    "mhtml-to-html": "./mhtml-to-html-node.js"
  },
  "module": "lib/mod.js",
  "exports": {
    ".": "./lib/mod-node.js",
    "./browser": "./lib/mod.js",
    "./deno": "./lib/mod-deno.js"
  },
  "types": "./lib/mod.d.ts",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "parse5": "^8.0.1"
  },
  "scripts": {
    "build": "./build.sh",
    "lint": "eslint",
    "test": "node --test \"test/*.test.js\"",
    "test:deno": "deno test --no-check --allow-read --allow-write --allow-env test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gildas-lormeau/mhtml-to-html.git"
  },
  "bugs": {
    "url": "https://github.com/gildas-lormeau/mhtml-to-html/issues"
  },
  "homepage": "https://github.com/gildas-lormeau/mhtml-to-html"
}
